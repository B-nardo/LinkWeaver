APP_NAME=Linkweaver
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database (MySQL 8)
# -----------------------------------------------------------------------------
# Local dev uses MySQL 8.4 on port 3307 to avoid colliding with XAMPP's MariaDB
# on 3306. The test suite runs against a separate `linkweaver_test` database
# (hardcoded in phpunit.xml, since this PHP build has no pdo_sqlite). Create
# both databases once:
#   CREATE DATABASE linkweaver;
#   CREATE DATABASE linkweaver_test;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=linkweaver
DB_USERNAME=root
DB_PASSWORD=

# Managed MySQL providers (TiDB Cloud, Aiven) require TLS. Set the CA bundle
# path to enable a verified SSL connection; leave blank for local development.
MYSQL_ATTR_SSL_CA=

# -----------------------------------------------------------------------------
# Queue / cache / session
# -----------------------------------------------------------------------------
# The whole pipeline runs on the database queue driver so the app needs no Redis
# on free-tier hosting. Run a worker with: php artisan queue:work
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Frontend / CORS
# -----------------------------------------------------------------------------
# Origin of the React SPA. Drives the CORS allow-list. In production this is the
# Cloudflare Pages / Netlify URL.
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Crawler
# -----------------------------------------------------------------------------
LINKWEAVER_MAX_PAGES=200
LINKWEAVER_SITEMAP_MAX_DEPTH=3
LINKWEAVER_SKIP_TAXONOMIES=true
LINKWEAVER_CONNECT_TIMEOUT=10
LINKWEAVER_TIMEOUT=15
LINKWEAVER_MAX_BYTES=2097152
LINKWEAVER_MAX_REDIRECTS=3
LINKWEAVER_REQUESTS_PER_SECOND=2
LINKWEAVER_RESPECT_ROBOTS=true
LINKWEAVER_MAX_CRAWL_DELAY=5

# -----------------------------------------------------------------------------
# Analysis
# -----------------------------------------------------------------------------
LINKWEAVER_SIMILARITY_THRESHOLD=0.75
LINKWEAVER_CANDIDATES_PER_PAGE=5
LINKWEAVER_SIMILARITY_WEIGHT=0.6
LINKWEAVER_SCARCITY_WEIGHT=0.4

# -----------------------------------------------------------------------------
# Google Gemini (phase 3+)
# -----------------------------------------------------------------------------
# Get a free key from Google AI Studio: https://aistudio.google.com/apikey
# Model names are deliberately left blank — set them from Google's current API
# docs rather than from memory, and confirm batch-embedding support.
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=
GEMINI_TEXT_MODEL=
GEMINI_REQUESTS_PER_MINUTE=12
